# ShiftSync v2 — variables de entorno.
# Copia este archivo a .env.local y rellena los valores. Runbook completo:
# docs/operacion/variables-entorno.md
#
# REGLA DE SEGURIDAD: todo lo que lleva el prefijo VITE_ termina en el paquete
# que descarga el navegador y es PÚBLICO. La clave de servicio NUNCA lleva VITE_.

# --- Navegador (público, plan §5.6: anon no lee ninguna tabla directamente) ---
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=

# --- Funciones de /api (servidor; NUNCA con prefijo VITE_) ---
# Las usa api/hoja.ts para validar el token de la sesión y la lista de admins.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Pruebas end-to-end (opcional) ---
# URL contra la que corre Playwright. Por defecto http://localhost:5173
# E2E_BASE_URL=
